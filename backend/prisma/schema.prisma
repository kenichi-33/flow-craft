generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FormDefinition {
  id        String   @id @default(uuid())
  name      String
  schema    Json     // フォーム構造定義 (RJSF schema)
  defaultFlowId String? @map("default_flow_id") // デフォルトフローID
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  applications Application[]
  applicationDefinitions ApplicationDefinition[]

  @@map("form_definitions")
}

model FlowDefinition {
  id        String   @id @default(uuid())
  name      String
  nodes     Json     // フローノード定義
  edges     Json     // フロー接続定義
  swimlanes Json?    // スイムレーン定義 (担当者割当ルール含む)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  applications Application[]
  applicationDefinitions ApplicationDefinition[]

  @@map("flow_definitions")
}

model Application {
  id                      String   @id @default(uuid())
  applicationNumber       Int      @default(autoincrement()) @map("application_number")
  title                   String   @default("無題") // 件名
  applicationDefinitionId String?  @map("application_definition_id")
  formDefinitionId        String   @map("form_definition_id")
  flowDefinitionId        String   @map("flow_definition_id")
  applicantId             String   @map("applicant_id")
  // スナップショット: 申請者情報 { username, firstName, lastName, email, department }
  applicantInfo           Json?    @map("applicant_info")
  status                  ApplicationStatus @default(DRAFT)
  inputData               Json     @map("input_data")
  currentNodeId           String?  @map("current_node_id")
  // スナップショット: 申請時点のフォーム・フロー定義を保存（バージョン互換性のため）
  formSchema              Json?    @map("form_schema")
  flowNodes               Json?    @map("flow_nodes")
  flowEdges               Json?    @map("flow_edges")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  applicationDefinition ApplicationDefinition? @relation(fields: [applicationDefinitionId], references: [id])
  formDefinition        FormDefinition         @relation(fields: [formDefinitionId], references: [id])
  flowDefinition        FlowDefinition         @relation(fields: [flowDefinitionId], references: [id])

  // 新統合テーブル
  workflowTasks         WorkflowTask[]
  workflowTaskHistories WorkflowTaskHistory[]
  history               ApprovalHistory[]

  @@map("applications")
}

enum ApplicationStatus {
  DRAFT
  IN_PROGRESS
  APPROVED
  REJECTED
  REMANDED
}



enum TaskStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

model ApprovalHistory {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  actorId       String   @map("actor_id")
  // スナップショット: 実行者情報 { username, firstName, lastName, email, department }
  actorInfo     Json?    @map("actor_info")
  action        String   // APPROVE, REJECT, REMAND
  comment       String?
  stepId        String   @map("step_id")
  actedAt       DateTime @default(now()) @map("acted_at")

  application   Application @relation(fields: [applicationId], references: [id])

  @@map("approval_histories")
}



// 新統合テーブル: ServiceTask と ApprovalTask を統合
model WorkflowTask {
  id            String     @id @default(uuid())
  applicationId String     @map("application_id")
  stepId        String     @map("step_id")
  type          String     // approval, apiCall, llmCall, etc.
  status        TaskStatus @default(PENDING)
  
  // 承認タスク用（共通フィールド化）
  assignedTo        String?   @map("assigned_to")
  assignedToDisplay String?   @map("assigned_to_display")
  assignedToInfo    Json?     @map("assigned_to_info")
  dueDate           DateTime? @map("due_date")
  
  // タスク設定スナップショット（ノード設定を保存）
  config        Json?
  
  // 実行結果
  result        Json?
  error         String?
  retries       Int      @default(0)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application   Application @relation(fields: [applicationId], references: [id])
  history       WorkflowTaskHistory[]

  @@map("workflow_tasks")
}

model WorkflowTaskHistory {
  id            String     @id @default(uuid())
  taskId        String     @map("task_id")
  applicationId String     @map("application_id")
  stepId        String     @map("step_id")
  type          String
  status        TaskStatus
  result        Json?
  error         String?
  executedAt    DateTime   @default(now()) @map("executed_at")

  task          WorkflowTask @relation(fields: [taskId], references: [id])
  application   Application  @relation(fields: [applicationId], references: [id])

  @@map("workflow_task_histories")
}


// 申請アプリ定義（フォームとフローを紐づける）
model ApplicationDefinition {
  id               String       @id @default(uuid())
  name             String
  description      String?
  formDefinitionId String?      @map("form_definition_id")
  flowDefinitionId String?      @map("flow_definition_id")
  status           AppDefStatus @default(DRAFT)
  version          Int          @default(1)
  tags             String[]     @default([])
  publishedAt      DateTime?    @map("published_at")
  createdBy        String?      @map("created_by")
  updatedBy        String?      @map("updated_by")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id])
  flowDefinition   FlowDefinition? @relation(fields: [flowDefinitionId], references: [id])
  applications     Application[]
  versions         AppVersion[]

  @@map("application_definitions")
}

enum AppDefStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// アプリバージョン履歴
model AppVersion {
  id                      String   @id @default(uuid())
  applicationDefinitionId String   @map("application_definition_id")
  version                 Int
  formSchema              Json?    @map("form_schema")
  flowNodes               Json?    @map("flow_nodes")
  flowEdges               Json?    @map("flow_edges")
  publishedAt             DateTime @default(now()) @map("published_at")
  publishedBy             String?  @map("published_by")

  applicationDefinition   ApplicationDefinition @relation(fields: [applicationDefinitionId], references: [id])

  @@unique([applicationDefinitionId, version])
  @@map("app_versions")
}

// チーム（任意作成可能なグループ）
model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  members     TeamMember[]

  @@map("teams")
}

// チームメンバー（ユーザーまたは部署を紐付け）
model TeamMember {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  memberType String   @map("member_type") // 'user' | 'department'
  memberId   String   @map("member_id")   // ユーザー名 or グループパス
  createdAt  DateTime @default(now()) @map("created_at")

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberType, memberId])
  @@map("team_members")
}

// アップロードされたファイル
model File {
  id            String   @id @default(uuid())
  filename      String   // 表示用ファイル名
  originalName  String   @map("original_name") // 元のファイル名
  mimeType      String   @map("mime_type")
  size          Int      // バイト数
  bucket        String
  key           String   // S3/MinIOのオブジェクトキー
  status        String   @default("pending") // pending, uploaded, deleted
  applicationId String?  @map("application_id")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("files")
}
